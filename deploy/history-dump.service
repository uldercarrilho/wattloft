[Unit]
Description=Dump Wattloft History to Object Storage
After=wattloft-env.service docker.service
Requires=wattloft-env.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/etc/wattloft/oci.env
ExecStart=/usr/local/sbin/wattloft-history-dump
