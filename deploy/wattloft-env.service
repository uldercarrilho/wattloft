[Unit]
Description=Write Wattloft env file from OCI Vault (instance principal)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/etc/wattloft/oci.env
ExecStart=/usr/local/sbin/wattloft-env
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
